# Supabase Configuration
# Copia questo file come .env.local e inserisci i tuoi valori
# Li trovi su: Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://il-tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-chiave-anon-pubblica

# --- Pagamenti (Stripe) — lasciare vuoti finché non si attivano ---
# Attiva i pagamenti: true. Senza, chi ha fatto l'accesso ha viaggi completi come prima.
BILLING_ENABLED=false
# Chiave segreta di Stripe (Sviluppatori > Chiavi API). In prova: sk_test_...
STRIPE_SECRET_KEY=
# Segreto del webhook (lo stampa scripts/stripe-setup.mjs): whsec_...
STRIPE_WEBHOOK_SECRET=
# Chiave "service_role" di Supabase (Settings > API). SEGRETA: mai nel codice, solo qui e su Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Indirizzo pubblico del sito (senza / finale), es. https://planwithelly.com
NEXT_PUBLIC_SITE_URL=
